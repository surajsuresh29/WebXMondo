---
/**
 * contact.astro — /contact
 * 2-column layout with left-hand context and right-hand ContactForm card.
 */
import Base from '../layouts/Base.astro';
import Dot from '../components/Dot.astro';
import ContactForm from '../components/ContactForm.astro';
import { contactEmail } from '../config/site';
---

<Base
  title="Contact Us — Web X Mondo | Simplifying Tech, Amplifying Brand"
  description="Get in touch with Web X Mondo. Whether you're looking to build a website, launch a mobile app, or enhance your brand through digital marketing, we're here to help."
>
  <!-- Contact section: 2-column layout (5fr context : 7fr form card) -->
  <section class="contact-section" aria-label="Contact information and inquiry form">
    <div class="container contact-grid">
      <!-- Left Column: Sticky Context -->
      <div class="contact-context">
        <div class="context-hero" data-reveal>
          <div class="eyebrow">
            <Dot size={6} />
            <span>Get in touch</span>
          </div>
          <h1 class="page-heading">Let's discuss your project.</h1>
          <p class="page-intro">
            Whether you’re looking to build a powerful website, launch a mobile app, or enhance your
            brand through strategic digital marketing, we’re here to help you achieve your goals.
          </p>
        </div>

        <!-- Contact details -->
        <aside class="contact-details" aria-label="Contact details" data-reveal>
          <div class="detail-group">
            <p class="mono detail-label">Email</p>
            <a href={`mailto:${contactEmail}`} class="detail-value text-link">
              {contactEmail}
            </a>
          </div>

          <div class="detail-group">
            <p class="mono detail-label">Mission</p>
            <p class="detail-value">Simplifying tech, amplifying brand.</p>
          </div>
        </aside>
      </div>

      <!-- Right Column: Surface Card Wrapper -->
      <div class="contact-form-card" data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>

<style>
  /* Contact section & layout */
  .contact-section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  /* 2. 2-column CSS Grid container (.contact-grid) with a 5fr 7fr split on desktop */
  .contact-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* 3. Left Column (Context): Sticky anchored at top: calc(var(--nav-h) + 4rem) */
  .contact-context {
    position: sticky;
    top: calc(var(--nav-h) + 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .context-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .page-heading {
    font-size: clamp(38px, 4.5vw, 56px);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    margin-block: var(--space-xs) var(--space-sm);
  }

  .page-intro {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 38ch;
    margin: 0;
  }

  /* Contact metadata */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-sm);
  }

  .detail-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  .detail-value {
    font-size: 15px;
    color: var(--color-ink);
    line-height: 1.5;
    margin: 0;
  }

  .text-link {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }

  /* 4. Right Column (Form): Surface card wrapper (.contact-form-card) */
  .contact-form-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-line);
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 4px 30px rgba(14, 14, 13, 0.03);
  }

  :root[data-theme="dark"] .contact-form-card,
  [data-theme="dark"] .contact-form-card {
    background-color: var(--color-surface);
  }

  /* 5. Responsive collapse on viewports < 900px */
  @media (max-width: 900px) {
    .contact-section {
      padding-block: var(--space-lg) var(--space-xl);
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .contact-context {
      position: static;
      top: auto;
      gap: var(--space-lg);
    }

    .contact-form-card {
      padding: clamp(1.5rem, 5vw, 2.5rem);
      border-radius: 20px;
    }
  }
</style>
