---
/**
 * 404.astro — Custom 404 page.
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Dot from '../components/Dot.astro';
---

<Base
  title="Page Not Found — Web X Mondo"
  description="The page you're looking for doesn't exist. Head back to the homepage."
>
  <section class="not-found">
    <div class="container not-found-inner">
      <div class="eyebrow" data-reveal>
        <Dot size={6} />
        <span class="mono">404</span>
      </div>
      <h1 class="not-found-heading" data-reveal>Wrong turn.</h1>
      <p class="not-found-body" data-reveal>
        That page doesn't exist. It may have moved, or the link might be broken.
      </p>
      <div class="not-found-actions" data-reveal>
        <Button href="/" id="not-found-home-btn">Back to home</Button>
        <Button href="/contact" variant="secondary" id="not-found-contact-btn">Contact us</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-block: var(--space-2xl);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .not-found-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 44ch;
  }

  .not-found-heading {
    margin-top: var(--space-xs);
    font-size: clamp(56px, 10vw, 120px);
  }

  .not-found-body {
    font-size: 18px;
    color: var(--color-muted);
    max-width: 30ch;
  }

  .not-found-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }
</style>
