---
/**
 * index.astro — Home page (/)
 * Sections:
 *   1. Hero — headline ≤6 words, paragraph ≤40 words
 *   2. Services list — 4 hairline-ruled rows
 *   3. Dark positioning band — full-bleed
 *   4. Project teasers — 3 cards from content collection
 *   5. Closing CTA
 * JSON-LD: Organization
 * Orchestrated hero entrance animation (homepage only).
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Dot from '../components/Dot.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Web Mondo',
  url: 'https://webmondo.com',
  description: 'Simplifying tech, amplifying brand. Digital solutions across branding, web design, mobile apps, software, and marketing.',
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hello@webmondo.com',
    contactType: 'customer support',
  },
};
---

<Base
  title="Web Mondo — Simplifying Tech, Amplifying Brand"
  description="At Web Mondo, we believe in the power of technology to transform businesses. We craft tailored digital solutions across branding, websites, mobile apps, marketing, and software."
  jsonLd={organizationSchema}
>
  <!-- ===== 1. HERO CARD ===== -->
  <section class="sticky-card hero" id="card-hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <div class="hero-eyebrow hero-animate">
        <Dot size={7} />
        <span class="mono">Digital Solutions</span>
      </div>

      <h1 id="hero-heading" class="hero-headline hero-animate hero-animate-delay-1">
        Simplifying tech,<br />amplifying brand.
      </h1>

      <p class="hero-body hero-animate hero-animate-delay-2">
        We specialize in creating innovative solutions that streamline your digital presence
        and elevate your brand to new heights. Websites, mobile apps, marketing, and custom software.
      </p>

      <div class="hero-actions hero-animate hero-animate-delay-3">
        <Button href="/contact" id="hero-cta-primary">Start a project</Button>
        <Button href="/services" variant="secondary" id="hero-cta-secondary">Our services</Button>
      </div>
    </div>
  </section>

  <!-- ===== 2. SERVICES CARD ===== -->
  <section class="sticky-card services-card" id="card-services" aria-labelledby="services-heading">
    <div class="container services-inner">
      <div class="services-header-left">
        <div class="eyebrow">
          <Dot size={6} />
          <span>Our Services</span>
        </div>
        <h2 id="services-heading" class="section-title">Five disciplines.<br />One trusted partner.</h2>
      </div>

      <div class="services-header-right">
        <p class="services-supporting">
          We lead with websites and search, and add brand, app and software work when your product needs it.
        </p>
        <Button href="/services" variant="primary" id="home-services-btn" class="services-explore-btn">
          <span>Explore all services</span>
          <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M2.5 7H11.5M11.5 7L7.5 3M11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </Button>
      </div>

      <div class="services-bento-grid">
        <!-- 1. Website Development (Feature tile: span 3) -->
        <a
          href="/services#website-development"
          class="bento-tile bento-tile--feature"
          aria-labelledby="service-title-website"
          aria-describedby="service-desc-website"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">DESIGN · BUILD · LAUNCH</p>
            <h3 id="service-title-website" class="bento-tile-title">Website Development</h3>
            <p id="service-desc-website" class="bento-tile-copy">Fast, responsive websites built to turn visitors into enquiries, and to be found on search from day one.</p>
          </div>
          <div class="bento-tile-media" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--website" viewBox="0 0 160 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <rect x="0.5" y="0.5" width="159" height="99" rx="8" fill="var(--color-surface)" stroke="var(--color-line)"/>
              <path d="M0.5 8C0.5 3.85786 3.85786 0.5 8 0.5H152C156.142 0.5 159.5 3.85786 159.5 8V20.5H0.5V8Z" fill="var(--color-surface-subtle)" stroke="var(--color-line)"/>
              <circle cx="10" cy="10.5" r="2.5" fill="var(--color-line)"/>
              <circle cx="18" cy="10.5" r="2.5" fill="var(--color-line)"/>
              <circle cx="26" cy="10.5" r="2.5" fill="var(--color-line)"/>
              <rect x="36" y="5.5" width="70" height="10" rx="4" fill="var(--color-bg)"/>
              <rect x="14" y="32" width="68" height="9" rx="3" fill="var(--color-ink)"/>
              <rect x="14" y="48" width="95" height="5" rx="2" fill="var(--color-muted)" opacity="0.45"/>
              <rect x="14" y="58" width="72" height="5" rx="2" fill="var(--color-muted)" opacity="0.35"/>
              <rect x="14" y="72" width="38" height="15" rx="4" fill="var(--color-accent)"/>
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- 2. Digital Marketing (Feature tile: span 3) -->
        <a
          href="/services#digital-marketing"
          class="bento-tile bento-tile--feature"
          aria-labelledby="service-title-marketing"
          aria-describedby="service-desc-marketing"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">SEO · PPC · SOCIAL · EMAIL</p>
            <h3 id="service-title-marketing" class="bento-tile-title">Digital Marketing</h3>
            <p id="service-desc-marketing" class="bento-tile-copy">Search-led growth: SEO first, with PPC, social and email alongside, measured by the enquiries they bring in.</p>
          </div>
          <div class="bento-tile-media" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--marketing" viewBox="0 0 160 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <rect x="1" y="2" width="158" height="28" rx="6" fill="var(--color-surface)" stroke="var(--color-accent)" stroke-width="1.5"/>
              <rect x="7" y="8" width="16" height="16" rx="4" fill="var(--color-accent)"/>
              <text x="15" y="20" fill="var(--color-surface)" font-family="var(--font-sans)" font-size="10" font-weight="700" text-anchor="middle">1</text>
              <rect x="29" y="8" width="68" height="6" rx="2" fill="var(--color-accent)"/>
              <rect x="29" y="18" width="100" height="4" rx="2" fill="var(--color-muted)" opacity="0.5"/>

              <rect x="1" y="36" width="158" height="28" rx="6" fill="var(--color-surface)" stroke="var(--color-line)" stroke-width="1"/>
              <rect x="7" y="42" width="16" height="16" rx="4" fill="var(--color-surface-subtle)"/>
              <text x="15" y="54" fill="var(--color-muted)" font-family="var(--font-sans)" font-size="10" font-weight="500" text-anchor="middle">2</text>
              <rect x="29" y="42" width="60" height="6" rx="2" fill="var(--color-ink)"/>
              <rect x="29" y="52" width="90" height="4" rx="2" fill="var(--color-muted)" opacity="0.4"/>

              <rect x="1" y="70" width="158" height="28" rx="6" fill="var(--color-surface)" stroke="var(--color-line)" stroke-width="1"/>
              <rect x="7" y="76" width="16" height="16" rx="4" fill="var(--color-surface-subtle)"/>
              <text x="15" y="88" fill="var(--color-muted)" font-family="var(--font-sans)" font-size="10" font-weight="500" text-anchor="middle">3</text>
              <rect x="29" y="76" width="52" height="6" rx="2" fill="var(--color-ink)"/>
              <rect x="29" y="86" width="78" height="4" rx="2" fill="var(--color-muted)" opacity="0.3"/>
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- 3. Branding & Designing (Standard tile: span 2) -->
        <a
          href="/services#branding-designing"
          class="bento-tile bento-tile--standard"
          aria-labelledby="service-title-branding"
          aria-describedby="service-desc-branding"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">LOGO · COLOR · TYPOGRAPHY</p>
            <h3 id="service-title-branding" class="bento-tile-title">Branding & Designing</h3>
            <p id="service-desc-branding" class="bento-tile-copy">Logos, color and typography that work together, so your brand looks the same on every page, app and ad.</p>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- 4. Mobile App Development (Standard tile: span 2) -->
        <a
          href="/services#mobile-app-development"
          class="bento-tile bento-tile--standard"
          aria-labelledby="service-title-mobile"
          aria-describedby="service-desc-mobile"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">IOS · ANDROID</p>
            <h3 id="service-title-mobile" class="bento-tile-title">Mobile App Development</h3>
            <p id="service-desc-mobile" class="bento-tile-copy">iOS and Android apps built around how your customers use them, from first screen to store release.</p>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <!-- 5. Software Solutions (Standard tile: span 2) -->
        <a
          href="/services#software-solutions"
          class="bento-tile bento-tile--standard"
          aria-labelledby="service-title-software"
          aria-describedby="service-desc-software"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">CUSTOM BUILDS</p>
            <h3 id="service-title-software" class="bento-tile-title">Software Solutions</h3>
            <p id="service-desc-software" class="bento-tile-copy">Custom software that streamlines day-to-day operations, so your team spends less time on manual work.</p>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== 3. POSITIONING BAND (DARK CARD) ===== -->
  <section class="sticky-card positioning-band section-dark" id="card-positioning" aria-labelledby="positioning-heading">
    <div class="container positioning-inner">
      <div class="eyebrow positioning-eyebrow">
        <Dot size={6} />
        <span class="mono" style="color: var(--color-accent);">Our Vision</span>
      </div>
      <p id="positioning-heading" class="positioning-statement">
        To empower businesses by simplifying technology, creating innovative solutions, and amplifying their brand presence in a digital world.
      </p>
      <Button href="/about" id="home-about-btn">Our Story & Mission</Button>
    </div>
  </section>

  <!-- ===== 4. PROJECT TEASERS CARD ===== -->
  <section class="sticky-card work-section" id="card-work" aria-labelledby="work-heading">
    <div class="container work-inner">
      <div class="section-header">
        <div class="eyebrow">
          <Dot size={6} />
          <span>Selected work</span>
        </div>
        <h2 id="work-heading" class="section-title">Real clients.<br />Real numbers.</h2>
      </div>

      <div class="work-grid">
        {works.map((project) => (
          <ProjectCard
            title={project.data.title}
            client={project.data.client}
            tagline={project.data.tagline}
            services={project.data.services}
            slug={project.id}
            coverSrc={project.data.coverSrc}
            coverAlt={project.data.coverAlt}
          />
        ))}
      </div>

      <div class="work-cta">
        <Button href="/work" variant="secondary" id="home-work-btn">All case studies</Button>
      </div>
    </div>
  </section>

  <!-- ===== 5. CLOSING CTA CARD ===== -->
  <section class="sticky-card closing-cta" id="card-cta" aria-labelledby="cta-heading">
    <div class="container closing-inner">
      <div class="eyebrow">
        <Dot size={6} />
        <span>Ready to scale?</span>
      </div>
      <h2 id="cta-heading" class="closing-heading">Tell us what you're building.</h2>
      <p class="closing-body">
        Whether you're looking to build a powerful website, launch a mobile app, or enhance your brand through strategic marketing, we're here to help you achieve your goals.
      </p>
      <Button href="/contact" id="home-closing-cta-btn">Start a project</Button>
    </div>
  </section>
</Base>

<style>
  /* ===== STICKY STACKING DECK (ONLY WHEN USABLE) ===== */
  @media (min-width: 900px) and (min-height: 680px) {
    .sticky-card {
      position: sticky;
      top: var(--nav-h); /* Docks flush against the real rendered header */
      min-height: calc(100dvh - var(--nav-h));
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-top: 1px solid var(--color-line);
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      box-shadow:
        0 -4px 12px -2px rgba(14, 14, 13, 0.04),
        0 -16px 36px -6px rgba(14, 14, 13, 0.06);
      background-color: var(--color-bg);
      padding-block: clamp(1.5rem, 3vh, 2.75rem);
    }

    /* Section 1: Hero — sits flush below nav at base */
    .hero {
      position: sticky;
      top: var(--nav-h);
      justify-content: flex-start;
      border-top-left-radius: 0;
      border-top-right-radius: 0;
      border-top: none;
      box-shadow: none;
      z-index: 1;
      padding-top: clamp(1.75rem, 4vh, 3rem);
      padding-bottom: clamp(2rem, 5vh, 4rem);
    }

    /* Section 2: Services — crisp white surface sliding over Hero */
    .services-card {
      z-index: 2;
      background-color: var(--color-surface);
      justify-content: center;
      padding-block: clamp(1.5rem, 3.5vh, 2.5rem);
    }

    /* Section 3: Positioning band — bold obsidian dark card */
    .positioning-band {
      z-index: 3;
      background-color: var(--color-deep);
      color: #FAF8F5;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        0 -4px 10px -2px rgba(14, 14, 13, 0.08),
        0 -10px 24px -8px rgba(14, 14, 13, 0.10);
    }

    /* Section 4: Work — opts out of sticky when height < 900px so its 3 projects can scroll naturally without clipping */
    .work-section {
      position: relative;
      top: auto;
      min-height: auto;
      z-index: 4;
      background-color: var(--color-bg);
      padding-top: clamp(3rem, 6vh, 4.5rem);
      padding-bottom: calc(clamp(3rem, 6vh, 4.5rem) + 28px);
      margin-bottom: -28px;
    }

    @media (min-height: 900px) {
      .work-section {
        position: sticky;
        top: var(--nav-h);
        min-height: calc(100dvh - var(--nav-h));
        padding-block: clamp(1.5rem, 3vh, 2.75rem);
        margin-bottom: 0;
      }
    }

    /* Section 5: Closing CTA — clean white card */
    .closing-cta {
      z-index: 5;
      background-color: var(--color-surface);
      border-bottom: 1px solid var(--color-line);
    }

    /* Dark mode shadow refinement inside usable deck */
    :root[data-theme="dark"] .sticky-card {
      box-shadow:
        0 -4px 14px -2px rgba(0, 0, 0, 0.35),
        0 -20px 40px -8px rgba(0, 0, 0, 0.55);
      border-top-color: rgba(255, 255, 255, 0.08);
    }

    /* Base overlay for scroll-driven depth dimming */
    .sticky-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-color: var(--color-deep);
      opacity: 0;
      pointer-events: none;
      z-index: 10;
    }

    /* Scroll-driven depth effect: scale to 0.95 and fade in dark overlay */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        :global(#main-content) {
          timeline-scope: --to-services, --to-positioning, --to-work, --to-cta;
        }

        #card-services {
          view-timeline-name: --to-services;
          view-timeline-axis: block;
        }
        #card-positioning {
          view-timeline-name: --to-positioning;
          view-timeline-axis: block;
        }
        #card-work {
          view-timeline-name: --to-work;
          view-timeline-axis: block;
        }
        #card-cta {
          view-timeline-name: --to-cta;
          view-timeline-axis: block;
        }

        #card-hero {
          transform-origin: top center;
          animation: deck-scale linear both;
          animation-timeline: --to-services;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }
        #card-hero::after {
          animation: deck-dim linear both;
          animation-timeline: --to-services;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }

        #card-services {
          transform-origin: top center;
          animation: deck-scale linear both;
          animation-timeline: --to-positioning;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }
        #card-services::after {
          animation: deck-dim linear both;
          animation-timeline: --to-positioning;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }

        #card-positioning {
          transform-origin: top center;
          animation: deck-scale linear both;
          animation-timeline: --to-work;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }
        #card-positioning::after {
          animation: deck-dim linear both;
          animation-timeline: --to-work;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }

        /* Work animation gated to min-height: 900px when it is sticky */
        @media (min-height: 900px) {
          #card-work {
            transform-origin: top center;
            animation: deck-scale linear both;
            animation-timeline: --to-cta;
            animation-range: entry 0% entry calc(100vh - var(--nav-h));
          }
          #card-work::after {
            animation: deck-dim linear both;
            animation-timeline: --to-cta;
            animation-range: entry 0% entry calc(100vh - var(--nav-h));
          }
        }
      }
    }
  }

  @keyframes deck-scale {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(0.95);
    }
  }

  @keyframes deck-dim {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.3;
    }
  }

  /* Fallback / Below 900px width or below 680px height: standard document flow with no sticky & no overlap */
  @media (max-width: 899px), (max-height: 679px) {
    .sticky-card {
      position: static;
      min-height: auto;
      border-radius: 0;
      box-shadow: none;
      padding-block: clamp(3rem, 12vw, 4.5rem);
      border-bottom: 1px solid var(--color-line);
    }
  }

  /* ===== 1. HERO ===== */
  .hero {
    background:
      radial-gradient(ellipse 60% 45% at 50% 65%, rgba(255, 85, 0, 0.035) 0%, rgba(255, 85, 0, 0.008) 50%, transparent 75%),
      var(--color-bg);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-eyebrow .mono {
    color: var(--color-muted);
  }

  .hero-headline {
    margin-top: var(--space-sm);
  }

  .hero-body {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 34ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
  }

  /* ===== 2. SERVICES ===== */
  .services-inner {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 900px) {
    .services-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "left right"
        "grid grid";
      column-gap: 2.5rem;
    }

    .services-header-left {
      grid-area: left;
      display: flex;
      flex-direction: column;
      align-self: end;
      gap: 0.6rem;
    }

    .services-header-left .eyebrow {
      margin-bottom: 0;
    }

    .services-header-left .section-title {
      margin-top: 0;
    }

    .services-header-right {
      grid-area: right;
      align-self: end;
    }

    .services-bento-grid {
      grid-area: grid;
      margin-top: clamp(1.25rem, 3vh, 1.75rem);
    }
  }

  @media (max-width: 899px) {
    .services-inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .services-header-left { order: 1; }
    .services-header-right { order: 2; margin-bottom: var(--space-xs); }
    .services-bento-grid { order: 3; }
  }

  .services-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 44ch;
  }

  .services-supporting {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-muted);
  }

  /* Tall screens (>= 800px height, >= 900px width): vertical balance and comfortable breathing room for Services card only */
  @media (min-width: 900px) and (min-height: 800px) {
    .services-card {
      justify-content: center;
      padding-block: clamp(2rem, 5vh, 3.5rem);
    }

    .services-card .services-bento-grid {
      margin-top: clamp(1.25rem, 3.5vh, 2.25rem);
      gap: 1rem;
    }

    .services-card .bento-tile {
      padding: clamp(1.1rem, 1.6vw, 1.5rem);
    }

    .services-card .bento-illustration {
      max-height: 112px;
    }
  }

  /* Explore All Services button arrow */
