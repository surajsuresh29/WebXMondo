---
/**
 * index.astro — Home page (/)
 * Sections:
 *   1. Hero — headline ≤6 words, paragraph ≤40 words
 *   2. Services list — 4 hairline-ruled rows
 *   3. Dark positioning band — full-bleed
 *   4. Project teasers — 3 cards from content collection
 *   5. Closing CTA
 * JSON-LD: Organization
 * Orchestrated hero entrance animation (homepage only).
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Dot from '../components/Dot.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_EMAIL } from '../data/site';
import { getCollection } from 'astro:content';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Web X Mondo',
  url: 'https://webmondo.com',
  description: 'Simplifying tech, amplifying brand. Digital solutions across branding, web design, mobile apps, software, and marketing.',
  contactPoint: {
    '@type': 'ContactPoint',
    email: SITE_EMAIL,
    contactType: 'customer support',
  },
};
---

<Base
  title="Web X Mondo — Simplifying Tech, Amplifying Brand"
  description="At Web X Mondo, we believe in the power of technology to transform businesses. We craft tailored digital solutions across branding, websites, mobile apps, marketing, and software."
  jsonLd={organizationSchema}
>
  <!-- ===== 1. HERO CARD ===== -->
  <section class="sticky-card hero" id="card-hero" aria-labelledby="hero-heading">
    <div class="container hero-inner">
      <div class="hero-eyebrow">
        <Dot size={7} />
        <span class="mono">WEB DESIGN · SEO</span>
      </div>

      <h1 id="hero-heading" class="hero-headline">
        <span class="headline-mask"><span class="headline-line headline-line--1">Simplifying tech,</span></span>
        <span class="headline-mask"><span class="headline-line headline-line--2">amplifying brand.</span></span>
      </h1>

      <div class="hero-row">
        <div class="hero-text-col">
          <p class="hero-body">
            We design and build websites that load fast, read clearly and get found on search.
          </p>

          <div class="hero-actions">
            <Button href="/contact" id="hero-cta-primary">Let’s build</Button>
            <Button href="/work" variant="secondary" id="hero-cta-secondary">See our work</Button>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true" focusable="false">
          <div class="hero-visual-glow"></div>
          <svg
            class="hero-visual-svg"
            viewBox="0 24 400 180"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            focusable="false"
          >
            <!-- Faint 4-line grid -->
            <line class="hero-grid-line" x1="10" y1="48" x2="390" y2="48" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
            <line class="hero-grid-line" x1="10" y1="96" x2="390" y2="96" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
            <line class="hero-grid-line" x1="10" y1="144" x2="390" y2="144" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />
            <line class="hero-grid-line" x1="10" y1="192" x2="390" y2="192" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="4 4" opacity="0.6" />

            <!-- Climbing stepped rise line -->
            <path
              class="hero-visual-line"
              d="M 24 192 C 54 192, 64 192, 88 192 C 114 192, 122 144, 152 144 C 182 144, 194 144, 218 144 C 244 144, 252 96, 278 96 C 304 96, 314 96, 332 96 C 350 96, 356 48, 372 48"
              stroke="var(--color-ink)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              pathLength="100"
            />

            <!-- Dot and ring at end of line -->
            <g class="hero-visual-marker">
              <circle class="hero-visual-ring" cx="372" cy="48" r="12" fill="var(--color-accent)" opacity="0.2" />
              <circle class="hero-visual-dot" cx="372" cy="48" r="6" fill="var(--color-accent)" />
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 2. SERVICES CARD ===== -->
  <section class="sticky-card services-card" id="card-services" aria-labelledby="services-heading">
    <div class="container services-inner">
      <div class="services-header" data-reveal-group>
        <div class="services-header-left" data-reveal>
          <div class="eyebrow">
            <Dot size={6} />
            <span>Our Services</span>
          </div>
          <h2 id="services-heading" class="section-title">Five disciplines.<br />One trusted partner.</h2>
        </div>

        <div class="services-header-right" data-reveal>
          <p class="services-supporting">
            We lead with websites and search, and add brand, app and software work when your product needs it.
          </p>
          <Button href="/services" variant="primary" id="home-services-btn" class="services-explore-btn">
            <span>Explore all services</span>
            <svg class="btn-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
              <path d="M2.5 7H11.5M11.5 7L7.5 3M11.5 7L7.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
            </svg>
          </Button>
        </div>
      </div>

      <div class="services-bento-grid" data-reveal-group>
        <!-- 1. Website Development (Feature tile: span 3) -->
        <a
          href="/services#website-development"
          class="bento-tile bento-tile--feature"
          data-reveal
          aria-labelledby="service-title-website"
          aria-describedby="service-desc-website"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">DESIGN · BUILD · LAUNCH</p>
            <h3 id="service-title-website" class="bento-tile-title">Website Development</h3>
            <p id="service-desc-website" class="bento-tile-copy">Fast, responsive websites built to turn visitors into enquiries, and to be found on search from day one.</p>
          </div>
          <div class="bento-tile-media" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--website" viewBox="0 0 140 85" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <rect class="draw-path draw-frame" pathLength="100" x="2" y="2" width="136" height="81" rx="7" stroke="var(--color-line)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-bar" pathLength="100" x1="2" y1="19" x2="138" y2="19" stroke="var(--color-line)" stroke-width="1" vector-effect="non-scaling-stroke" />
              <circle class="draw-fill" cx="10" cy="10.5" r="2" fill="var(--color-line)" />
              <circle class="draw-fill" cx="17" cy="10.5" r="2" fill="var(--color-line)" />
              <circle class="draw-fill" cx="24" cy="10.5" r="2" fill="var(--color-line)" />
              <rect class="draw-path draw-url" pathLength="100" x="34" y="6" width="66" height="9" rx="3" stroke="var(--color-line)" stroke-width="1" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-wire-1" pathLength="100" x1="14" y1="33" x2="68" y2="33" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-wire-2" pathLength="100" x1="14" y1="44" x2="112" y2="44" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" opacity="0.6" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-wire-3" pathLength="100" x1="14" y1="53" x2="88" y2="53" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" opacity="0.45" vector-effect="non-scaling-stroke" />
              <rect class="draw-path draw-btn-rect" pathLength="100" x="14" y="63" width="36" height="13" rx="3.5" stroke="var(--color-accent)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </a>

        <!-- 2. Digital Marketing (Feature tile: span 3) -->
        <a
          href="/services#digital-marketing"
          class="bento-tile bento-tile--feature"
          data-reveal
          aria-labelledby="service-title-marketing"
          aria-describedby="service-desc-marketing"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">SEO · PPC · SOCIAL · EMAIL</p>
            <h3 id="service-title-marketing" class="bento-tile-title">Digital Marketing</h3>
            <p id="service-desc-marketing" class="bento-tile-copy">Search-led growth: SEO first, with PPC, social and email alongside, measured by the enquiries they bring in.</p>
          </div>
          <div class="bento-tile-media" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--marketing" viewBox="0 0 140 85" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <line class="draw-grid-line" x1="10" y1="72" x2="130" y2="72" stroke="var(--color-line)" stroke-width="1" opacity="0.5" vector-effect="non-scaling-stroke" />
              <line class="draw-grid-line" x1="10" y1="46" x2="130" y2="46" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="2 3" opacity="0.5" vector-effect="non-scaling-stroke" />
              <line class="draw-grid-line" x1="10" y1="20" x2="130" y2="20" stroke="var(--color-line)" stroke-width="1" stroke-dasharray="2 3" opacity="0.5" vector-effect="non-scaling-stroke" />
              <path class="draw-path draw-seo-line" pathLength="100" d="M 12 65 C 38 63, 52 68, 72 50 C 92 32, 108 38, 128 14" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
              <circle class="draw-fill" cx="128" cy="14" r="3.5" fill="var(--color-accent)" />
              <circle class="draw-path draw-pulse" pathLength="100" cx="128" cy="14" r="6.5" stroke="var(--color-accent)" stroke-width="1" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </a>

        <!-- 3. Branding & Designing (Standard tile: span 2) -->
        <a
          href="/services#branding-designing"
          class="bento-tile bento-tile--standard"
          data-reveal
          aria-labelledby="service-title-branding"
          aria-describedby="service-desc-branding"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">LOGO · COLOR · TYPOGRAPHY</p>
            <h3 id="service-title-branding" class="bento-tile-title">Branding & Designing</h3>
            <p id="service-desc-branding" class="bento-tile-copy">Logos, color and typography that work together, so your brand looks the same on every page, app and ad.</p>
          </div>
          <div class="bento-tile-media bento-tile-media--standard" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--branding" viewBox="0 0 100 65" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <rect class="draw-path draw-swatch-1" pathLength="100" x="10" y="16" width="28" height="42" rx="4" transform="rotate(-15 24 37)" stroke="var(--color-line)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
              <rect class="draw-path draw-swatch-2" pathLength="100" x="35" y="10" width="28" height="44" rx="4" transform="rotate(-3 49 32)" stroke="var(--color-muted)" stroke-width="1.5" opacity="0.6" vector-effect="non-scaling-stroke" />
              <rect class="draw-path draw-swatch-3" pathLength="100" x="56" y="12" width="30" height="44" rx="4" transform="rotate(11 71 34)" stroke="var(--color-accent)" stroke-width="1.75" vector-effect="non-scaling-stroke" />
              <circle class="draw-fill" cx="71" cy="26" r="4" fill="var(--color-accent)" />
              <line class="draw-path draw-swatch-line" pathLength="100" x1="64" y1="42" x2="80" y2="45" stroke="var(--color-ink)" stroke-width="1.2" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </a>

        <!-- 4. Mobile App Development (Standard tile: span 2) -->
        <a
          href="/services#mobile-app-development"
          class="bento-tile bento-tile--standard"
          data-reveal
          aria-labelledby="service-title-mobile"
          aria-describedby="service-desc-mobile"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">IOS · ANDROID</p>
            <h3 id="service-title-mobile" class="bento-tile-title">Mobile App Development</h3>
            <p id="service-desc-mobile" class="bento-tile-copy">iOS and Android apps built around how your customers use them, from first screen to store release.</p>
          </div>
          <div class="bento-tile-media bento-tile-media--standard" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--mobile" viewBox="0 0 100 65" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <rect class="draw-path draw-phone-body" pathLength="100" x="31" y="4" width="38" height="57" rx="8" stroke="var(--color-ink)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-phone-speaker" pathLength="100" x1="44" y1="9" x2="56" y2="9" stroke="var(--color-muted)" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              <rect class="draw-path draw-phone-card" pathLength="100" x="37" y="17" width="26" height="22" rx="4" stroke="var(--color-accent)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-phone-metric" pathLength="100" x1="42" y1="26" x2="55" y2="26" stroke="var(--color-accent)" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-phone-sub" pathLength="100" x1="42" y1="32" x2="52" y2="32" stroke="var(--color-muted)" stroke-width="1" stroke-linecap="round" opacity="0.6" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-phone-home" pathLength="100" x1="43" y1="55" x2="57" y2="55" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </a>

        <!-- 5. Software Solutions (Standard tile: span 2) -->
        <a
          href="/services#software-solutions"
          class="bento-tile bento-tile--standard"
          data-reveal
          aria-labelledby="service-title-software"
          aria-describedby="service-desc-software"
        >
          <div class="bento-tile-main">
            <p class="mono bento-tile-label">CUSTOM BUILDS</p>
            <h3 id="service-title-software" class="bento-tile-title">Software Solutions</h3>
            <p id="service-desc-software" class="bento-tile-copy">Custom software that streamlines day-to-day operations, so your team spends less time on manual work.</p>
          </div>
          <div class="bento-tile-media bento-tile-media--standard" aria-hidden="true">
            <svg class="bento-illustration bento-illustration--software" viewBox="0 0 100 65" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path class="draw-path draw-bracket-l" pathLength="100" d="M 28 18 L 16 32.5 L 28 47" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
              <line class="draw-path draw-bracket-slash" pathLength="100" x1="56" y1="14" x2="44" y2="51" stroke="var(--color-accent)" stroke-width="2.25" stroke-linecap="round" vector-effect="non-scaling-stroke" />
              <path class="draw-path draw-bracket-r" pathLength="100" d="M 72 18 L 84 32.5 L 72 47" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
              <circle class="draw-fill" cx="44" cy="58" r="2" fill="var(--color-muted)" />
              <circle class="draw-fill" cx="52" cy="58" r="2" fill="var(--color-accent)" />
              <circle class="draw-fill" cx="60" cy="58" r="2" fill="var(--color-muted)" />
            </svg>
          </div>
          <svg class="tile-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
            <path d="M3.5 10.5L10.5 3.5M10.5 3.5H4.5M10.5 3.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== 3. POSITIONING BAND (DARK CARD) ===== -->
  <section class="sticky-card positioning-band section-dark" id="card-positioning" aria-labelledby="positioning-heading">
    <div class="container positioning-inner" data-reveal>
      <div class="eyebrow positioning-eyebrow">
        <Dot size={6} />
        <span class="mono" style="color: var(--color-accent);">Our Vision</span>
      </div>
      <p id="positioning-heading" class="positioning-statement">
        To empower businesses by simplifying technology, creating innovative solutions, and amplifying their brand presence in a digital world.
      </p>
      <Button href="/about" id="home-about-btn">Our Story & Mission</Button>
    </div>
  </section>

  <!-- ===== 4. PROJECT TEASERS CARD ===== -->
  <section class="sticky-card work-section" id="card-work" aria-labelledby="work-heading">
    <div class="container work-inner">
      <div class="section-header" data-reveal>
        <div class="eyebrow">
          <Dot size={6} />
          <span>Selected work</span>
        </div>
        <h2 id="work-heading" class="section-title">Real clients.<br />Real numbers.</h2>
      </div>

      <div class="work-grid" data-reveal-group>
        {works.map((project) => (
          <ProjectCard
            title={project.data.title}
            client={project.data.client}
            tagline={project.data.tagline}
            services={project.data.services}
            slug={project.id}
            coverSrc={project.data.coverSrc}
            coverAlt={project.data.coverAlt}
          />
        ))}
      </div>

      <div class="work-cta" data-reveal>
        <Button href="/work" variant="secondary" id="home-work-btn">All case studies</Button>
      </div>
    </div>
  </section>

  <!-- ===== 5. CLOSING CTA CARD ===== -->
  <section class="sticky-card closing-cta" id="card-cta" aria-labelledby="cta-heading">
    <div class="container closing-inner">
      <div class="eyebrow">
        <Dot size={6} />
        <span>Ready to scale?</span>
      </div>
      <h2 id="cta-heading" class="closing-heading">Tell us what you're building.</h2>
      <p class="closing-body">
        Tell us what you need: a new website, better search visibility, an app or a brand refresh. We'll come back with the next steps.
      </p>
      <div class="closing-actions">
        <Button href="/contact" id="home-closing-cta-btn">Let’s build</Button>
        <a href={`mailto:${SITE_EMAIL}`} class="closing-email-link mono">{SITE_EMAIL}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== STICKY STACKING DECK (ONLY WHEN USABLE) ===== */
  @media (min-width: 900px) and (min-height: 680px) {
    .sticky-card {
      position: sticky;
      top: var(--nav-h); /* Docks flush against the real rendered header */
      min-height: calc(100dvh - var(--nav-h));
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-top: 1px solid var(--color-line);
      border-top-left-radius: 28px;
      border-top-right-radius: 28px;
      box-shadow:
        0 -4px 12px -2px rgba(14, 14, 13, 0.04),
        0 -16px 36px -6px rgba(14, 14, 13, 0.06);
      background-color: var(--color-bg);
      padding-block: clamp(1.5rem, 3vh, 2.75rem);
    }

    .sticky-card a,
    .sticky-card button,
    .sticky-card input,
    .sticky-card select,
    .sticky-card textarea {
      scroll-margin-top: calc(var(--nav-h) + 2rem);
    }

    /* Section 1: Hero — sits flush below nav at base */
    .hero {
      position: sticky;
      top: var(--nav-h);
      justify-content: flex-start;
      border-top-left-radius: 0;
      border-top-right-radius: 0;
      border-top: none;
      box-shadow: none;
      z-index: 1;
      padding-top: clamp(1.75rem, 4vh, 3rem);
      padding-bottom: clamp(2rem, 5vh, 4rem);
    }

    @media (max-height: 799px) {
      .hero {
        justify-content: center;
        padding-block: clamp(1.5rem, 3.5vh, 2.5rem);
      }
    }

    @media (min-height: 800px) {
      .hero {
        justify-content: center;
        padding-block: clamp(2rem, 5vh, 3.5rem);
      }
    }

    /* Section 2: Services — crisp white surface sliding over Hero */
    .services-card {
      z-index: 2;
      background-color: var(--color-surface);
      justify-content: center;
      padding-block: clamp(1.5rem, 3.5vh, 2.5rem);
    }

    /* Section 3: Positioning band — bold obsidian dark card */
    .positioning-band {
      z-index: 3;
      background-color: var(--color-deep);
      color: #FAF8F5;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow:
        0 -4px 10px -2px rgba(14, 14, 13, 0.08),
        0 -10px 24px -8px rgba(14, 14, 13, 0.10);
    }

    /* Section 4: Work — opts out of sticky when height < 900px so its 3 projects can scroll naturally without clipping */
    .work-section {
      position: relative;
      top: auto;
      min-height: auto;
      z-index: 4;
      background-color: var(--color-bg);
      padding-top: clamp(3rem, 6vh, 4.5rem);
      padding-bottom: calc(clamp(3rem, 6vh, 4.5rem) + 28px);
      margin-bottom: -28px;
    }

    @media (min-height: 900px) {
      .work-section {
        position: sticky;
        top: var(--nav-h);
        min-height: calc(100dvh - var(--nav-h));
        padding-block: clamp(1.5rem, 3vh, 2.75rem);
        margin-bottom: 0;
      }
    }

    /* Section 5: Closing CTA — clean white card */
    .closing-cta {
      z-index: 5;
      background-color: var(--color-surface);
      border-bottom: none;
    }

    /* Dark mode shadow refinement inside usable deck */
    :root[data-theme="dark"] .sticky-card {
      box-shadow:
        0 -4px 14px -2px rgba(0, 0, 0, 0.35),
        0 -20px 40px -8px rgba(0, 0, 0, 0.55);
      border-top-color: rgba(255, 255, 255, 0.08);
    }

    /* Base overlay for scroll-driven depth dimming */
    .sticky-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background-color: var(--color-deep);
      opacity: 0;
      pointer-events: none;
      z-index: 10;
    }

    /* Scroll-driven depth effect: scale to 0.95 and fade in dark overlay */
    @supports (animation-timeline: view()) {
      @media (prefers-reduced-motion: no-preference) {
        :global(#main-content) {
          timeline-scope: --to-services, --to-positioning, --to-work, --to-cta;
        }

        #card-services {
          view-timeline-name: --to-services;
          view-timeline-axis: block;
        }
        #card-positioning {
          view-timeline-name: --to-positioning;
          view-timeline-axis: block;
        }
        #card-work {
          view-timeline-name: --to-work;
          view-timeline-axis: block;
        }
        #card-cta {
          view-timeline-name: --to-cta;
          view-timeline-axis: block;
        }

        #card-hero {
          transform-origin: top center;
          animation: deck-scale linear both;
          animation-timeline: --to-services;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }
        #card-hero::after {
          animation: deck-dim linear both;
          animation-timeline: --to-services;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }

        #card-services {
          transform-origin: top center;
          animation: deck-scale linear both;
          animation-timeline: --to-positioning;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }
        #card-services::after {
          animation: deck-dim linear both;
          animation-timeline: --to-positioning;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }

        #card-positioning {
          transform-origin: top center;
          animation: deck-scale linear both;
          animation-timeline: --to-work;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }
        #card-positioning::after {
          animation: deck-dim linear both;
          animation-timeline: --to-work;
          animation-range: entry 0% entry calc(100vh - var(--nav-h));
        }

        /* Work animation gated to min-height: 900px when it is sticky */
        @media (min-height: 900px) {
          #card-work {
            transform-origin: top center;
            animation: deck-scale linear both;
            animation-timeline: --to-cta;
            animation-range: entry 0% entry calc(100vh - var(--nav-h));
          }
          #card-work::after {
            animation: deck-dim linear both;
            animation-timeline: --to-cta;
            animation-range: entry 0% entry calc(100vh - var(--nav-h));
          }
        }
      }
    }
  }

  @keyframes deck-scale {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(0.95);
    }
  }

  @keyframes deck-dim {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.3;
    }
  }

  /* Fallback / Below 900px width or below 680px height: standard document flow with no sticky & no overlap */
  @media (max-width: 899px), (max-height: 679px) {
    .sticky-card {
      position: static;
      min-height: auto;
      border-radius: 0;
      box-shadow: none;
      padding-block: clamp(3rem, 12vw, 4.5rem);
      border-bottom: 1px solid var(--color-line);
    }

    .closing-cta {
      border-bottom: none;
    }
  }

  /* ===== 1. HERO ===== */
  .hero {
    background-color: var(--color-bg);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-eyebrow .mono {
    color: var(--color-muted);
  }

  .hero-headline {
    margin-top: var(--space-sm);
  }

  /* Headline reveal animation (two lines) */
  .headline-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .headline-line {
    display: block;
    transform: translateY(105%);
    animation: headline-line-in 560ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .headline-line--1 {
    animation-delay: 0ms;
  }

  .headline-line--2 {
    animation-delay: 90ms;
  }

  @keyframes headline-line-in {
    from {
      transform: translateY(105%);
    }
    to {
      transform: translateY(0);
    }
  }

  /* Default row layout (<1100px wide or <680px high: visual hidden, layout unchanged) */
  .hero-row {
    display: contents;
  }

  .hero-text-col {
    display: contents;
  }

  .hero-visual {
    display: none;
  }

  .hero-body {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 34ch;
    animation: hero-fade-up 420ms cubic-bezier(0.2, 0.7, 0.2, 1) 280ms both;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-sm);
    animation: hero-fade-up 420ms cubic-bezier(0.2, 0.7, 0.2, 1) 350ms both;
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Two-column layout only at >= 1100px wide AND >= 680px high */
  @media (min-width: 1100px) and (min-height: 680px) {
    .hero-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2.5rem;
      width: 100%;
      margin-top: -0.5rem;
    }

    .hero-text-col {
      display: flex;
      flex-direction: column;
      flex: 1 1 auto;
      max-width: 58%;
    }

    .hero-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 38%;
      width: 38%;
      max-width: 440px;
      max-height: 162px;
      position: relative;
      overflow: hidden;
      border-radius: var(--radius-card);
    }

    .hero-visual-glow {
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(closest-side at 62% 45%, rgba(255, 85, 0, 0.09) 0%, rgba(255, 85, 0, 0.02) 55%, transparent 100%);
      animation: hero-glow-in 700ms ease-out both;
    }

    :root[data-theme="dark"] .hero-visual-glow,
    [data-theme="dark"] .hero-visual-glow {
      background: radial-gradient(closest-side at 62% 45%, rgba(255, 94, 36, 0.13) 0%, rgba(255, 94, 36, 0.02) 55%, transparent 100%);
    }

    .hero-visual-svg {
      width: 100%;
      height: auto;
      max-height: 162px;
      max-width: 360px;
      aspect-ratio: 400 / 180;
      display: block;
      position: relative;
      z-index: 1;
    }

    .hero-visual-line {
      stroke-dasharray: 100 200;
      stroke-dashoffset: 100;
      animation: hero-line-draw 1100ms ease-out 450ms both;
    }

    .hero-visual-marker {
      transform-box: fill-box;
      transform-origin: center;
      animation: hero-marker-in 240ms cubic-bezier(0.2, 0.7, 0.2, 1) 1550ms both;
    }
  }

  @media (min-width: 1280px) and (min-height: 800px) {
    .hero-text-col {
      max-width: 50%;
    }

    .hero-visual {
      flex-basis: 44%;
      max-width: none;
      max-height: 210px;
    }

    .hero-visual-svg {
      max-width: none;
      max-height: 210px;
    }
  }

  @keyframes hero-glow-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes hero-line-draw {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes hero-marker-in {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Prefers-reduced-motion: reduce — no animation, everything in final state */
  @media (prefers-reduced-motion: reduce) {
    .headline-line,
    .hero-body,
    .hero-actions,
    .hero-visual-line,
    .hero-visual-marker,
    .hero-visual-glow {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
      stroke-dashoffset: 0 !important;
    }
  }

  /* ===== 2. SERVICES ===== */
  .services-inner {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 900px) {
    .services-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "left right"
        "grid grid";
      column-gap: 2.5rem;
    }

    .services-header-left {
      grid-area: left;
      display: flex;
      flex-direction: column;
      align-self: end;
      gap: 0.6rem;
    }

    .services-header-left .eyebrow {
      margin-bottom: 0;
    }

    .services-header-left .section-title {
      margin-top: 0;
    }

    .services-header-right {
      grid-area: right;
      align-self: end;
    }

    .services-bento-grid {
      grid-area: grid;
      margin-top: clamp(1.25rem, 3vh, 1.75rem);
    }
  }

  @media (max-width: 899px) {
    .services-inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .services-header-left { order: 1; }
    .services-header-right { order: 2; margin-bottom: var(--space-xs); }
    .services-bento-grid { order: 3; }
  }

  .services-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    max-width: 44ch;
  }

  .services-supporting {
    font-size: 15px;
    line-height: 1.45;
    color: var(--color-muted);
  }

  /* Tall screens (>= 800px height, >= 900px width): vertical balance and comfortable breathing room for Services card only */
  @media (min-width: 900px) and (min-height: 800px) {
    .services-card {
      justify-content: center;
      padding-block: clamp(2rem, 5vh, 3.5rem);
    }

    .services-card .services-bento-grid {
      margin-top: clamp(1.25rem, 3.5vh, 2.25rem);
      gap: 1rem;
    }

    .services-card .bento-tile {
      padding: clamp(1.1rem, 1.6vw, 1.5rem);
    }

    .services-card .bento-illustration {
      max-height: 112px;
    }
  }

  /* Explore All Services button arrow */
  :global(#home-services-btn) .btn-arrow,
  :global(.services-explore-btn) .btn-arrow {
    margin-left: 0.25rem;
    transition: transform 180ms ease;
    flex-shrink: 0;
  }

  :global(#home-services-btn:hover) .btn-arrow,
  :global(#home-services-btn:focus-visible) .btn-arrow,
  :global(.services-explore-btn:hover) .btn-arrow,
  :global(.services-explore-btn:focus-visible) .btn-arrow {
    transform: translateX(4px);
  }

  /* Bento Grid */
  .services-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .services-bento-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 0.75rem;
    }

    .bento-tile--feature {
      grid-column: span 3;
    }

    .bento-tile--standard {
      grid-column: span 2;
    }
  }

  /* Bento Tile Base */
  .bento-tile {
    position: relative;
    padding: clamp(0.9rem, 1.25vw, 1.15rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card, 16px);
    background-color: var(--color-bg);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 180ms ease, border-color 180ms ease;
    cursor: pointer;
  }

  .bento-tile:hover {
    transform: translateY(-2px);
    border-color: var(--color-line);
  }

  .bento-tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    transform: translateY(-2px);
    border-color: var(--color-accent);
  }

  .bento-tile .tile-arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    color: var(--color-muted);
    transition: transform 180ms ease, color 180ms ease;
    z-index: 3;
  }

  .bento-tile:hover .tile-arrow,
  .bento-tile:focus-visible .tile-arrow {
    transform: translate(4px, -4px);
    color: var(--color-accent);
  }

  .bento-tile-main {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .bento-tile-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    margin-bottom: 0.3rem;
    padding-right: 1.5rem; /* clearance for top-right arrow */
    line-height: 1.3;
  }

  .bento-tile-title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-bottom: 0.35rem;
    line-height: 1.2;
  }

  .bento-tile-copy {
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-muted);
    max-width: none;
  }

  /* Cursor-following border spotlight (only on hover-capable devices with motion allowed) */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bento-tile::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: radial-gradient(
        220px circle at var(--x, -999px) var(--y, -999px),
        var(--color-accent) 0%,
        rgba(255, 107, 0, 0.35) 45%,
        transparent 75%
      );
      -webkit-mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask:
        linear-gradient(#fff 0 0) content-box,
        linear-gradient(#fff 0 0);
      mask-composite: exclude;
      pointer-events: none;
      opacity: 0;
      transition: opacity 240ms ease;
      z-index: 2;
    }

    .bento-tile::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: radial-gradient(
        280px circle at var(--x, -999px) var(--y, -999px),
        rgba(255, 107, 0, 0.04) 0%,
        transparent 70%
      );
      pointer-events: none;
      opacity: 0;
      transition: opacity 240ms ease;
      z-index: 1;
    }

    .bento-tile:hover::before,
    .bento-tile:hover::after {
      opacity: 1;
    }
  }

  /* Bento Illustration Media */
  .bento-tile-media {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .bento-illustration {
    display: block;
    overflow: visible;
  }

  .bento-illustration path,
  .bento-illustration line,
  .bento-illustration rect,
  .tile-arrow path,
  .btn-arrow path {
    vector-effect: non-scaling-stroke;
  }

  .bento-tile-media--standard {
    margin-top: auto;
    padding-top: 0.5rem;
    height: 46px;
  }

  .bento-tile-media--standard .bento-illustration {
    height: 100%;
    width: auto;
    max-height: 46px;
  }

  /* Self-drawing SVG animation via stroke-dashoffset on reveal */
  @media (prefers-reduced-motion: no-preference) {
    .draw-path {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      transition: stroke-dashoffset 0.85s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: stroke-dashoffset;
    }

    .draw-fill {
      opacity: 0;
      transform: scale(0.5);
      transform-origin: center;
      transition:
        opacity 0.4s ease,
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .bento-tile.is-visible .draw-path {
      stroke-dashoffset: 0;
      transition-delay: calc(var(--stagger-delay, 0ms) + 100ms);
    }

    .bento-tile.is-visible .draw-fill {
      opacity: 1;
      transform: scale(1);
      transition-delay: calc(var(--stagger-delay, 0ms) + 360ms);
    }

    .bento-tile.is-visible .draw-pulse {
      animation: pulse-ring 2.4s ease-out infinite;
      animation-delay: calc(var(--stagger-delay, 0ms) + 1.2s);
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.85);
        opacity: 0.9;
      }
      50% {
        transform: scale(1.35);
        opacity: 0.25;
      }
      100% {
        transform: scale(0.85);
        opacity: 0.9;
      }
    }
  }

  /* Feature tile layout (Row 1): ~60% text, ~40% illustration on right */
  @media (min-width: 1100px) and (min-height: 680px) {
    .bento-tile--feature {
      flex-direction: row;
      align-items: flex-start;
      gap: 1rem;
    }

    .bento-tile--feature .bento-tile-main {
      flex: 1 1 60%;
      min-width: 0;
    }

    .bento-tile--feature .bento-tile-media {
      flex: 0 0 38%;
      max-width: 38%;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: center;
      margin-right: 0.75rem;
    }

    .bento-illustration--website,
    .bento-illustration--marketing {
      width: 100%;
      height: auto;
      max-height: 88px;
    }
  }

  /* On mobile (< 900px), feature tile illustrations align bottom-right */
  @media (max-width: 899px) {
    .bento-tile--feature .bento-tile-media {
      align-self: flex-end;
      height: 52px;
      margin-top: 0.5rem;
    }
    .bento-tile--feature .bento-illustration {
      height: 100%;
      width: auto;
      max-height: 52px;
    }
  }

  /* Hide illustrations only on tablet viewport during sticky deck (900-1099px) or short viewport (< 680px) to prevent card overflow */
  @media (min-width: 900px) and (max-width: 1099px) and (min-height: 680px), (min-width: 900px) and (max-height: 679px) {
    .bento-tile-media {
      display: none !important;
    }
    .bento-tile--feature {
      flex-direction: column !important;
      align-items: stretch !important;
    }
  }

  /* Section Header & Title (Work section and general sections) */
  .section-header {
    margin-bottom: var(--space-md);
  }

  .section-title {
    margin-top: var(--space-xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-tile,
    .bento-tile .tile-arrow,
    :global(#home-services-btn) .btn-arrow,
    :global(.services-explore-btn) .btn-arrow {
      transition: none !important;
      transform: none !important;
    }
    .bento-tile:hover,
    .bento-tile:focus-visible {
      transform: none !important;
    }
    .bento-tile:hover .tile-arrow,
    .bento-tile:focus-visible .tile-arrow {
      transform: none !important;
    }
    .bento-tile::before,
    .bento-tile::after {
      display: none !important;
    }
    .draw-path {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .draw-fill {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .draw-pulse {
      animation: none !important;
    }
    :global(#home-services-btn:hover) .btn-arrow,
    :global(#home-services-btn:focus-visible) .btn-arrow,
    :global(.services-explore-btn:hover) .btn-arrow,
    :global(.services-explore-btn:focus-visible) .btn-arrow {
      transform: none !important;
    }
  }

  /* ===== 3. POSITIONING BAND ===== */
  .positioning-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 52ch;
  }

  .positioning-eyebrow {
    margin-bottom: 0;
  }

  .positioning-statement {
    font-family: var(--font-sans);
    font-size: clamp(22px, 3.5vw, 36px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
    color: #FAF8F5;
    max-width: 26ch;
  }

  /* ===== 4. WORK TEASERS ===== */
  .work-inner {
    display: flex;
    flex-direction: column;
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 768px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .work-cta {
    margin-top: var(--space-md);
  }

  /* ===== 5. CLOSING CTA ===== */
  .closing-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    width: 100%;
  }

  .closing-inner .eyebrow {
    margin-bottom: 0;
  }

  @media (min-width: 900px) and (min-height: 680px) {
    .closing-inner {
      margin-top: -54px;
    }
  }

  .closing-heading {
    margin-top: 0;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.05;
    text-wrap: balance;
    max-width: 18ch;
  }

  .closing-body {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 44ch;
  }

  .closing-actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .closing-actions :global(#home-closing-cta-btn) {
    align-self: flex-start;
    width: fit-content;
  }

  .closing-email-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.12em;
    text-decoration: none;
    padding-inline: 0.25rem;
    transition: color var(--transition-ui), text-decoration var(--transition-ui);
  }

  .closing-email-link:hover,
  .closing-email-link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .closing-email-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Motion: scroll-driven entrance reveal completing when panel docks */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .closing-heading {
        animation: cta-rise 520ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }

      .closing-body {
        animation: cta-fade 520ms cubic-bezier(0.2, 0.7, 0.2, 1) 60ms both;
        animation-timeline: view();
        animation-range: entry 10% cover 50%;
      }

      .closing-actions {
        animation: cta-fade 520ms cubic-bezier(0.2, 0.7, 0.2, 1) 120ms both;
        animation-timeline: view();
        animation-range: entry 15% cover 50%;
      }
    }
  }

  @keyframes cta-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cta-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  (function () {
    if (!window.matchMedia('(hover: hover)').matches) return;

    var tiles = document.querySelectorAll('.bento-tile');
    if (!tiles.length) return;

    tiles.forEach(function (tile) {
      var rafId = null;
      var lastX = 0;
      var lastY = 0;

      function updatePosition() {
        tile.style.setProperty('--x', lastX + 'px');
        tile.style.setProperty('--y', lastY + 'px');
        rafId = null;
      }

      tile.addEventListener(
        'pointermove',
        function (e) {
          var rect = tile.getBoundingClientRect();
          lastX = e.clientX - rect.left;
          lastY = e.clientY - rect.top;

          if (rafId === null) {
            rafId = requestAnimationFrame(updatePosition);
          }
        },
        { passive: true }
      );

      tile.addEventListener('pointerleave', function () {
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
        tile.style.removeProperty('--x');
        tile.style.removeProperty('--y');
      });
    });
  })();
</script>

