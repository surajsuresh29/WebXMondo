---
/**
 * work/index.astro — /work
 * Grid of all project cards from content collection.
 */
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Dot from '../../components/Dot.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Work — Web X Mondo | Case Studies & Selected Projects"
  description="Case studies in branding, web development, mobile apps, and digital marketing by Web X Mondo. Real clients, real numbers."
>
  <!-- Page header -->
  <section class="page-header">
    <div class="container page-header-inner">
      <div class="eyebrow" data-reveal>
        <Dot size={6} />
        <span>Selected work</span>
      </div>
      <h1 class="page-heading" data-reveal>Projects that moved the needle.</h1>
      <p class="page-intro" data-reveal>
        We pick clients we can genuinely help, then we do the work properly. Here's what that looks like.
      </p>
    </div>
  </section>

  <!-- Project grid -->
  <section class="work-grid-section" aria-label="Case studies">
    <div class="container">
      <div class="work-grid" data-reveal-group>
        {works.map((project) => (
          <ProjectCard
            title={project.data.title}
            client={project.data.client}
            tagline={project.data.tagline}
            services={project.data.services}
            slug={project.id}
            coverSrc={project.data.coverSrc}
            coverAlt={project.data.coverAlt}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="work-cta-section" aria-labelledby="work-cta-heading">
    <div class="container work-cta-inner" data-reveal>
      <div class="eyebrow">
        <Dot size={6} />
        <span>Start a project</span>
      </div>
      <h2 id="work-cta-heading" class="work-cta-heading">
        Want your work here?
      </h2>
      <p>We take on a small number of new clients each quarter. The earlier you get in touch, the more likely we can fit you in.</p>
      <Button href="/contact" id="work-cta-btn">Start a project</Button>
    </div>
  </section>
</Base>

<style>
  .page-header {
    padding-block: var(--space-xl) var(--space-lg);
    border-bottom: 1px solid var(--color-line);
  }

  .page-header-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .page-heading { margin-top: var(--space-xs); }

  .page-intro {
    font-size: 18px;
    color: var(--color-muted);
    max-width: 34ch;
  }

  /* Grid */
  .work-grid-section {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-line);
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-md);
  }

  /* CTA */
  .work-cta-section {
    padding-block: var(--space-xl);
  }

  .work-cta-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 38ch;
  }

  .work-cta-heading {
    font-size: clamp(28px, 4vw, 44px);
    letter-spacing: -0.03em;
  }

  .work-cta-inner p {
    font-size: 15px;
    color: var(--color-muted);
    max-width: none;
  }


</style>
