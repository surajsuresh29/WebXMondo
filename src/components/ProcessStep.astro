---
/**
 * ProcessStep.astro — About page 4-step process item.
 * Props:
 *   number: string   — mono step label e.g. "01"
 *   title: string
 *   description: string  — ≤25 words
 */
interface Props {
  number: string;
  title: string;
  description: string;
}
const { number, title, description } = Astro.props;
---

<div class="process-step" data-reveal>
  <p class="mono step-number">{number}</p>
  <h3 class="step-title">{title}</h3>
  <p class="step-desc">{description}</p>
</div>

<style>
  .process-step {
    padding-block: var(--space-md);
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 3rem 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-sm);
    row-gap: 0.35rem;
  }

  .step-number {
    color: var(--color-muted);
    max-width: none;
    grid-column: 1;
    grid-row: 1;
    padding-top: 0.15rem;
  }

  .step-title {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    grid-column: 2;
    grid-row: 1;
  }

  .step-desc {
    font-size: 14px;
    color: var(--color-muted);
    max-width: none;
    grid-column: 2;
    grid-row: 2;
  }
</style>
