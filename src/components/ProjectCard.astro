---
/**
 * ProjectCard.astro — Work grid card.
 * No boxed shadows — uses 1px border for separation.
 * Hover: slight translateY + border-color shift.
 *
 * Props:
 *   title: string
 *   client: string
 *   tagline: string        — 1-line description
 *   services: string[]
 *   slug: string           — URL slug for case study
 *   coverSrc?: string      — image src
 *   coverAlt?: string
 */
interface Props {
  title: string;
  client: string;
  tagline: string;
  services: string[];
  slug: string;
  coverSrc?: string;
  coverAlt?: string;
}

const { title, client, tagline, services, slug, coverSrc, coverAlt } = Astro.props;
---

<article class="project-card" data-reveal>
  <a href={`/work/${slug}`} class="card-link" aria-label={`${title} — ${client} case study`}>
    {coverSrc && (
      <div class="card-cover">
        <img
          src={coverSrc}
          alt={coverAlt ?? title}
          width="720"
          height="480"
          loading="lazy"
          decoding="async"
        />
      </div>
    )}
    <div class="card-body">
      <p class="mono card-client">{client}</p>
      <h3 class="card-title">{title}</h3>
      <p class="card-tagline">{tagline}</p>
      <ul class="card-services mono" role="list">
        {services.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </a>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    border-radius: var(--radius-card, 16px);
    overflow: hidden;
    transition:
      transform var(--transition-hover),
      border-color var(--transition-hover),
      box-shadow var(--transition-hover);
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-muted);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.04);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Cover image */
  .card-cover {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: var(--color-surface-subtle);
  }

  .card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .project-card:hover .card-cover img {
    transform: scale(1.03);
  }

  /* Body */
  .card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .card-client {
    color: var(--color-muted);
    max-width: none;
  }

  .card-title {
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .card-tagline {
    font-size: 14px;
    color: var(--color-muted);
    max-width: none;
    margin-top: 0.25rem;
  }

  .card-services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    margin-top: 0.5rem;
  }

  .card-services li {
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .card-cover img { transition: none; }
    .project-card:hover { transform: none; }
    .project-card:hover .card-cover img { transform: none; }
  }
</style>
