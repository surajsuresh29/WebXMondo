---
/**
 * ServiceRow.astro — Hairline-ruled service row.
 * Layout: service name left | mono label right.
 * No cards, no shadows — just 1px top border.
 *
 * Props:
 *   name: string      — e.g. "Brand Identity"
 *   label: string     — mono label e.g. "01"
 *   href?: string     — optional link target
 */
interface Props {
  name: string;
  label: string;
  href?: string;
}

const { name, label, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={['service-row', { 'service-row--link': !!href }]}
  data-reveal
>
  <span class="service-name">{name}</span>
  <span class="mono service-label">{label}</span>
</Tag>

<style>
  .service-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-line);
    text-decoration: none;
    color: inherit;
  }

  .service-row--link {
    cursor: pointer;
    transition: color var(--transition-hover);
  }

  .service-row--link:hover .service-name {
    color: var(--color-muted);
  }

  .service-name {
    font-family: var(--font-sans);
    font-size: clamp(18px, 2.5vw, 28px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    transition: color var(--transition-hover);
  }

  .service-label {
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-row--link { transition: none; }
    .service-name { transition: none; }
  }
</style>
