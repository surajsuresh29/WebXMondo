---
/**
 * Footer.astro — Site footer with nav, contact details, mono domain.
 */
import Dot from './Dot.astro';
import { siteName, siteUrl, contactEmail } from '../config/site';

const siteHostname = new URL(siteUrl).hostname;

const footerLinks = [
  { label: 'Services', href: '/services' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <!-- Top row: logo + nav -->
    <div class="footer-top">
      <a href="/" class="footer-logo" aria-label="Web X Mondo — Home">
        <svg class="logo-mark" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M 18.8 5.8 A 9.2 9.2 0 1 0 18.8 18.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
          <circle cx="18.8" cy="5.8" r="1.9" fill="var(--color-accent)" />
          <circle cx="18.8" cy="18.2" r="1.9" fill="var(--color-accent)" />
        </svg>
        <span>Web <span class="logo-x">X</span> Mondo</span>
      </a>
      <nav aria-label="Footer navigation">
        <ul role="list" class="footer-nav">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <!-- Divider -->
    <hr class="footer-rule" />

    <!-- Bottom row: contact + domain -->
    <div class="footer-bottom">
      <div class="footer-contact">
        <p class="mono">Simplifying tech, amplifying brand.</p>
        <p class="mono">{contactEmail}</p>
      </div>
      <p class="footer-domain mono">{siteHostname}</p>
    </div>

    <!-- Copyright -->
    <p class="footer-copy mono">
      &copy; {new Date().getFullYear()} {siteName}. All rights reserved.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding-block: clamp(2.5rem, 5vh, 4rem) var(--space-lg);
    margin-top: 0;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Top row */
  .footer-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-decoration: none;
  }

  .footer-logo .logo-mark {
    display: block;
    flex-shrink: 0;
    transition: transform var(--transition-ui);
  }

  .footer-logo:hover .logo-mark {
    transform: rotate(45deg);
  }

  .logo-x {
    color: var(--color-accent);
    font-weight: 600;
    margin: 0 0.05em;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }

  .footer-link {
    font-size: 14px;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-ui);
  }

  .footer-link:hover { color: var(--color-ink); }

  /* Rule */
  .footer-rule {
    border: none;
    border-top: 1px solid var(--color-line);
    margin-block: var(--space-xs);
  }

  /* Bottom row */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-domain {
    color: var(--color-muted);
    letter-spacing: 0.12em;
  }

  .footer-copy {
    color: var(--color-muted);
    font-size: 9px;
    max-width: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link { transition: none; }
  }
</style>
