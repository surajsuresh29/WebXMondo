---
/**
 * Button.astro
 * Primary: --color-ink fill, --color-bg text, orange dot before label.
 * Secondary: 1px --color-ink border, no fill.
 *
 * Props:
 *   href?: string — renders <a> if provided, else <button>
 *   variant?: 'primary' | 'secondary' — defaults to 'primary'
 *   type?: 'button' | 'submit' | 'reset' — only used when no href
 *   id?: string
 */
import Dot from './Dot.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
}

const { href, variant = 'primary', type = 'button', id, class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
const isPrimary = variant === 'primary';
---

{href ? (
  <a
    href={href}
    id={id}
    class:list={['btn', isPrimary ? 'btn--primary' : 'btn--secondary', className]}
  >
    {isPrimary && <Dot />}
    <slot />
  </a>
) : (
  <button
    type={type}
    id={id}
    class:list={['btn', isPrimary ? 'btn--primary' : 'btn--secondary', className]}
  >
    {isPrimary && <Dot />}
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.4rem;
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    cursor: pointer;
    border-radius: var(--radius-btn, 9999px);
    border: 1px solid transparent;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-hover),
      color var(--transition-hover),
      border-color var(--transition-hover),
      transform var(--transition-hover),
      box-shadow var(--transition-hover);
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  /* Primary: ink fill with white text and orange dot */
  .btn--primary {
    background-color: var(--color-ink);
    color: #FFFFFF;
    border-color: var(--color-ink);
  }

  .btn--primary:hover {
    background-color: #242320;
    border-color: #242320;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  /* Secondary: clean surface with delicate hairline border */
  .btn--secondary {
    background-color: var(--color-surface);
    color: var(--color-ink);
    border-color: var(--color-line);
  }

  .btn--secondary:hover {
    background-color: var(--color-ink);
    color: #FFFFFF;
    border-color: var(--color-ink);
  }

  /* Support inside dark sections */
  :global(.section-dark) .btn--primary,
  :global(.panel-dark) .btn--primary {
    background-color: #FFFFFF;
    color: #0E0E0D;
    border-color: #FFFFFF;
  }

  :global(.section-dark) .btn--primary:hover,
  :global(.panel-dark) .btn--primary:hover {
    background-color: var(--color-surface-subtle);
    border-color: var(--color-surface-subtle);
  }

  :global(.section-dark) .btn--secondary,
  :global(.panel-dark) .btn--secondary {
    background-color: transparent;
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.25);
  }

  :global(.section-dark) .btn--secondary:hover,
  :global(.panel-dark) .btn--secondary:hover {
    background-color: #FFFFFF;
    color: #0E0E0D;
    border-color: #FFFFFF;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
    .btn:hover { transform: none; }
  }
</style>
